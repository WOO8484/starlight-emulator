<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Starlight</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>17.0</string>

    <!-- Files 앱/파일공유로 테스트 게임을 Documents 에 넣을 수 있게 함 -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- 지시문 16항: iPhone 16 Pro Max 고정. arm64 필수. -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>metal</string>
    </array>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>UILaunchScreen</key>
    <dict/>

    <!-- ARMSX2 entitlements 가 audio-input/camera 를 선언 → 사용 시 설명 문자열 필요 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>일부 PS2/Switch 타이틀의 마이크 입력에 사용됩니다.</string>
    <key>NSCameraUsageDescription</key>
    <string>일부 타이틀의 카메라(EyeToy 등) 기능에 사용됩니다.</string>

    <!-- 대용량 파일 접근을 위한 백그라운드 처리 여지(선택) -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>
