# ============================================================================
# Starlight Emulator — .gitignore (공개 저장소용)
# 원칙: 소스/Adapter/patch/빌드설정/CI/문서만 공개. 개인·저작권·비밀 자료는 제외.
# ============================================================================

# ---- 게임/펌웨어/키 (저작권·개인자료: 절대 금지) ----
*.iso
*.cso
*.chd
*.nsp
*.xci
*.pbp
*.rom
prod.keys
title.keys
*.keys
firmware/
bios/
BIOS/
05_testdata/**
!05_testdata/**/.gitkeep

# ---- Apple 서명/프로비저닝 (비밀) ----
*.p12
*.mobileprovision
*.cer
*.pem
*.key
*.certSigningRequest

# ---- 시크릿/토큰/환경 ----
.env
.env.*
secrets.*
*.secret
*token*
*.pat

# ---- 사용자 데이터/세이브 ----
saves/
save/
userdata/
UserData/
savestates/
memcards/

# ---- upstream 엔진 원본 (대용량: submodule/CI clone 로 관리) ----
01_sources/PPSSPP/
01_sources/ARMSX2/
01_sources/MeloNX/

# ---- 빌드 산출물/중간물 ----
_cache/
07_build/DerivedData/
07_build/prebuilt/
07_build/*.xcodeproj/
07_build/*.xcworkspace/
DerivedData/
build/
*.ipa
*.xcarchive
*.app/
09_output/Payload/
08_logs/*.log

# ---- macOS / Xcode ----
.DS_Store
xcuserdata/
*.xcuserstate

# ---- 기타 ----
*.tmp
Thumbs.db
